        <dc:Bounds x="1125" y="250" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_g_join_n_x6_Resolve_incident_in_resolver_group" bpmnElement="g_join_n_x6_Resolve_incident_in_resolver_group">
        <dc:Bounds x="1335" y="405" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1315" y="461" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_n_x6_Resolve_incident_in_resolver_group" bpmnElement="n_x6_Resolve_incident_in_resolver_group">
        <dc:Bounds x="1485" y="390" width="110" height="80" />
