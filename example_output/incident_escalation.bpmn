      <bpmndi:BPMNShape id="Shape_n_x7_Notification" bpmnElement="n_x7_Notification">
        <dc:Bounds x="1665" y="110" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_n_end" bpmnElement="n_end">
        <dc:Bounds x="1882" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1855" y="174" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_f_start_n_x1_Log_incident" bpmnElement="f_start_n_x1_Log_incident">
        <di:waypoint x="298" y="150" />
        <di:waypoint x="405" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_f_n_x1_Log_incident_n_x2_Triage" bpmnElement="f_n_x1_Log_incident_n_x2_Triage">
        <di:waypoint x="515" y="150" />
        <di:waypoint x="585" y="150" />
