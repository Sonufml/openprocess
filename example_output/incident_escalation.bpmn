        <di:waypoint x="875" y="150" />
        <di:waypoint x="975" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_f_g_x4_Major_incident_n_x5_Convene_major_incident_" bpmnElement="f_g_x4_Major_incident_n_x5_Convene_major_incident_">
