<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_change_approval" targetNamespace="http://openprocess.dev/schema/bpmn" exporter="OpenProcess" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_change_approval">
    <bpmn:participant id="Participant_change_approval" name="Approve standard change" processRef="Process_change_approval" />
  </bpmn:collaboration>
  <bpmn:process id="Process_change_approval" name="Approve standard change" isExecutable="false">
    <bpmn:laneSet id="LaneSet_change_approval">
      <bpmn:lane id="lane_Requester" name="Requester">
        <bpmn:flowNodeRef>n_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_x1_Submit_change_request</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_Change_Manager" name="Change Manager">
        <bpmn:flowNodeRef>n_x2_Screen_change_request_for_completeness</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_x3_Classify_change_risk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_x4_Is_the_change_standard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_x5_Approve_change_under_standing_authority</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_x9_Record_change_closure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_Change_Advisory_Board" name="Change Advisory Board">
        <bpmn:flowNodeRef>g_join_n_x6_Present_change_to_change_advisory_boar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_x6_Present_change_to_change_advisory_board</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_Technical_Lead" name="Technical Lead">
        <bpmn:flowNodeRef>n_x7_Implement_approved_change</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_x8_Verify_change_outcome</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="n_start" name="Change request submitted">
      <bpmn:outgoing>f_start_n_x1_Submit_change_request</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="n_x1_Submit_change_request" name="Submit change request">
      <bpmn:incoming>f_start_n_x1_Submit_change_request</bpmn:incoming>
      <bpmn:outgoing>f_n_x1_Submit_change_request_n_x2_Screen_change_re</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="n_x2_Screen_change_request_for_completeness" name="Screen change request for completeness">
      <bpmn:incoming>f_n_x1_Submit_change_request_n_x2_Screen_change_re</bpmn:incoming>
      <bpmn:outgoing>f_n_x2_Screen_change_request_for_completeness_n_x3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="n_x3_Classify_change_risk" name="Classify change risk">
      <bpmn:incoming>f_n_x2_Screen_change_request_for_completeness_n_x3</bpmn:incoming>
      <bpmn:outgoing>f_n_x3_Classify_change_risk_g_x4_Is_the_change_sta</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_x4_Is_the_change_standard" name="Is the change standard?">
      <bpmn:incoming>f_n_x3_Classify_change_risk_g_x4_Is_the_change_sta</bpmn:incoming>
      <bpmn:outgoing>f_g_x4_Is_the_change_standard_n_x5_Approve_change_</bpmn:outgoing>
      <bpmn:outgoing>f_g_x4_Is_the_change_standard_n_x6_Present_change_</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="n_x5_Approve_change_under_standing_authority" name="Approve change under standing authority">
      <bpmn:incoming>f_g_x4_Is_the_change_standard_n_x5_Approve_change_</bpmn:incoming>
      <bpmn:outgoing>f_n_x5_Approve_change_under_standing_authority_n_x</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_join_n_x6_Present_change_to_change_advisory_boar" name="">
      <bpmn:incoming>f_n_x5_Approve_change_under_standing_authority_n_x</bpmn:incoming>
      <bpmn:incoming>f_g_x4_Is_the_change_standard_n_x6_Present_change_</bpmn:incoming>
      <bpmn:outgoing>f_g_join_n_x6_Present_change_to_change_advisory_bo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="n_x6_Present_change_to_change_advisory_board" name="Present change to change advisory board">
      <bpmn:incoming>f_g_join_n_x6_Present_change_to_change_advisory_bo</bpmn:incoming>
      <bpmn:outgoing>f_n_x6_Present_change_to_change_advisory_board_n_x</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="n_x7_Implement_approved_change" name="Implement approved change">
      <bpmn:incoming>f_n_x6_Present_change_to_change_advisory_board_n_x</bpmn:incoming>
      <bpmn:outgoing>f_n_x7_Implement_approved_change_n_x8_Verify_chang</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="n_x8_Verify_change_outcome" name="Verify change outcome">
      <bpmn:incoming>f_n_x7_Implement_approved_change_n_x8_Verify_chang</bpmn:incoming>
      <bpmn:outgoing>f_n_x8_Verify_change_outcome_n_x9_Record_change_cl</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="n_x9_Record_change_closure" name="Record change closure">
      <bpmn:incoming>f_n_x8_Verify_change_outcome_n_x9_Record_change_cl</bpmn:incoming>
      <bpmn:outgoing>f_n_x9_Record_change_closure_end</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="n_end" name="Change closed and recorded">
      <bpmn:incoming>f_n_x9_Record_change_closure_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_start_n_x1_Submit_change_request" sourceRef="n_start" targetRef="n_x1_Submit_change_request" />
    <bpmn:sequenceFlow id="f_n_x1_Submit_change_request_n_x2_Screen_change_re" sourceRef="n_x1_Submit_change_request" targetRef="n_x2_Screen_change_request_for_completeness" />
    <bpmn:sequenceFlow id="f_n_x2_Screen_change_request_for_completeness_n_x3" sourceRef="n_x2_Screen_change_request_for_completeness" targetRef="n_x3_Classify_change_risk" />
    <bpmn:sequenceFlow id="f_n_x3_Classify_change_risk_g_x4_Is_the_change_sta" sourceRef="n_x3_Classify_change_risk" targetRef="g_x4_Is_the_change_standard" />
    <bpmn:sequenceFlow id="f_g_x4_Is_the_change_standard_n_x5_Approve_change_" sourceRef="g_x4_Is_the_change_standard" targetRef="n_x5_Approve_change_under_standing_authority" name="Change is standard">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Change is standard</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_n_x5_Approve_change_under_standing_authority_n_x" sourceRef="n_x5_Approve_change_under_standing_authority" targetRef="g_join_n_x6_Present_change_to_change_advisory_boar" />
    <bpmn:sequenceFlow id="f_n_x6_Present_change_to_change_advisory_board_n_x" sourceRef="n_x6_Present_change_to_change_advisory_board" targetRef="n_x7_Implement_approved_change" />
    <bpmn:sequenceFlow id="f_n_x7_Implement_approved_change_n_x8_Verify_chang" sourceRef="n_x7_Implement_approved_change" targetRef="n_x8_Verify_change_outcome" />
    <bpmn:sequenceFlow id="f_n_x8_Verify_change_outcome_n_x9_Record_change_cl" sourceRef="n_x8_Verify_change_outcome" targetRef="n_x9_Record_change_closure" />
    <bpmn:sequenceFlow id="f_n_x9_Record_change_closure_end" sourceRef="n_x9_Record_change_closure" targetRef="n_end" />
    <bpmn:sequenceFlow id="f_g_x4_Is_the_change_standard_n_x6_Present_change_" sourceRef="g_x4_Is_the_change_standard" targetRef="g_join_n_x6_Present_change_to_change_advisory_boar" name="Change is normal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Change is normal</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_g_join_n_x6_Present_change_to_change_advisory_bo" sourceRef="g_join_n_x6_Present_change_to_change_advisory_boar" targetRef="n_x6_Present_change_to_change_advisory_board" />
  </bpmn:process>
